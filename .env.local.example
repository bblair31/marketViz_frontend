# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket Configuration (for future real-time features)
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Optional: Alpha Vantage API Key (if calling directly from frontend)
# NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=your_key_here

# Server-side only variables (not exposed to client)
# API_SECRET_KEY=your_secret_key
