# MarketViz Frontend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git!

# Backend API Configuration
# For local development, use: http://localhost:3000/api/v1
# For production, use your deployed backend URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Alpha Vantage API Key (optional - backend handles most API calls)
# Only needed if you want to make direct API calls from frontend
# Get your free key at: https://www.alphavantage.co/support/#api-key
# VITE_ALPHA_VANTAGE_API_KEY=demo

# Optional: Environment identifier
VITE_ENV=development
